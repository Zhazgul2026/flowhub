{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/flowhub/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/backend/flowhub/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/backend/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}